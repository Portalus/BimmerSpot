@page "/Account/Manage"

@using System.ComponentModel.DataAnnotations
@using BimmerSpot.Data.Models
@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Profil</PageTitle>

<h3>Profil</h3>
<StatusMessage />

<div class="row">
    <div class="col-xl-6">
        <EditForm Model="Input" FormName="profile" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <input type="text" value="@username" id="username" class="form-control" disabled />
                <label for="username" class="form-label">Email</label>
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.CarModel" id="Input.CarModel" class="form-control"/>
                <label for="Input.PhoneNumber" class="form-label">Model samochodu</label>
                <ValidationMessage For="() => Input.CarModel" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Zapisz</button>
        </EditForm>
    </div>
</div>

@code {
    private ApplicationUser? user;
    private string? username;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        username = await UserManager.GetUserNameAsync(user);

        if(Input.CarModel is null)
        {
            Input.CarModel = user.CarModel;
        }
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        if(Input.CarModel != user.CarModel)
        {
            user.CarModel = Input.CarModel;

            await UserManager.UpdateAsync(user);
        }

        await SignInManager.RefreshSignInAsync(user);
        RedirectManager.RedirectToCurrentPageWithStatus("Twoje dane zostały zaktualizowane.", HttpContext);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Wprowadź model posiadanego samochodu")]
        [Display(Name = "Model Samochodu")]
        public string? CarModel { get; set; }
    }
}
