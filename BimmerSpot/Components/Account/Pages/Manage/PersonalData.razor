@page "/Account/Manage/PersonalData"

@using BimmerSpot.Data.Models
@using BimmerSpot.Services
@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject IFeatureFlagService FeatureFlagService

<PageTitle>Dane osobiste</PageTitle>

<h3>Dane osobiste</h3>
<StatusMessage />

<div class="row">
    <div class="col-md-6">
        <p>Twoje konto zawiera dane osobiste, które nam przekazałeś. Tutaj możesz je pobrać lub usunąć.</p>
        <p>
            <strong>Usunięcie danych spowoduje usunięcie konta, bez możliwośći przywócenia.</strong>
        </p>
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">Pobierz</button>
            <p></p>
        </form>
        <p>
            <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">Usuń konto</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
