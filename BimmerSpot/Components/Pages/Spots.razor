@page "/spots"

@attribute [Authorize]
@attribute [StreamRendering]

@rendermode InteractiveServer

@inject ISpotService SpotService
@inject IUserService UserService

@using BimmerSpot.Components.Pages.Modals
@using BimmerSpot.Data.Models
@using BimmerSpot.Services
@using Microsoft.AspNetCore.Authorization

<PageTitle>Lista Spotów</PageTitle>

<hr />

<div class="btn-group mb-4" role="group" aria-label="Typ wydarzeń">
    <button type="button"
        class="btn @(ShowUpcoming ? "btn-primary" : "btn-outline-primary")"
        @onclick="ShowUpcomingSpots">
        Nadchodzące
    </button>

    <button type="button"
        class="btn @(!ShowUpcoming ? "btn-primary" : "btn-outline-primary")"
        @onclick="ShowPastSpots">
        Minione
    </button>
</div>

<!---------------------------------- Modals --------------------------------->
<AttendantsModal Spot="SelectedSpot" OnClose="CloseAttendantsModal" CurrentUser="CurrentUser" />

<DescriptionModal Spot="SelectedDescriptionSpot" OnClose="CloseDescriptionModal" />

<!---------------------------------- Table ---------------------------------->
@if (spots == null)
{ 
    <p><em>Ładowanie...</em></p>
}
else if (spots.Count == 0)
{ 
    <div class="alert alert-light border">
        @(ShowUpcoming
            ? "Brak nadchodzących spotów."
            : "Brak minionych spotów.") 
    </div>
}
else
{
    <div class="list-group">
    @foreach (var spot in spots)
    { 
        <div class="list-group-item"> 
            <div class="row align-items-center">

                <!-- Data i godzina -->
                <div class="col-md-2">
                    <div class="fw-semibold">
                        @spot.StartDateTime.ToString("dd.MM.yyyy")
                    </div>
                    <div class="text-body-secondary small">
                        @spot.StartDateTime.ToString("HH:mm")
                    </div>
                </div>

                <!-- Miasto + ulica -->
                <div class="col-md-3">
                    <div class="fw-semibold">
                        @spot.City
                    </div>
                    <div class="text-body-secondary small">
                        @spot.StreetAndNumber
                    </div>
                </div>

                <!-- Opis -->
                <div class="col-md-4">
                    @if (spot.Description?.Length > 40)
                    {
                        <span>
                            @spot.Description.Substring(0, 40)...
                        </span>

                        <button type="button"
                                class="btn btn-link btn-sm p-0"
                                @onclick="() => OpenDescriptionModal(spot)">
                            więcej
                        </button>
                    }
                    else
                    {
                        <span>@spot.Description</span>
                    }
                </div>

                <div class="col-md-3">
                    <!-- Map -->
                    <a class="btn btn-sm d-inline-block mt-2 btn-outline-primary"
                        href="@GetGoogleMapsUrl(spot)"
                        target="_blank"
                        rel="noopener noreferrer">
                        Mapa
                    </a>

                    <!-- Attendants -->
                    <button type="button"
                        class="btn btn-sm d-inline-block mt-2 btn-outline-primary"
                        @onclick="() => OpenAttendantsModal(spot)">
                        Uczestnicy: @spot.Attendants.Count/10
                    </button>

                    <!-- Join or Leave -->
                    @if (spot.StartDateTime > DateTime.Now.AddHours(-1) &&
                        spot.Attendants.Count < 10)
                    {
                        <button type="button"
                            class="btn btn-sm mt-2 @(spot.Attendants.Any(a => a.Id == CurrentUser.Id)
                                ? "btn-outline-danger"
                                : "btn-success")"
                            @onclick="() => JoinOrLeaveSpotAsync(spot)">
                            @(spot.Attendants.Any(a => a.Id == CurrentUser.Id)
                                ? "Zrezygnuj"
                                : "Dołącz")
                        </button>
                    }    
                </div>
            </div>
        </div>
    }
    </div>
}

<!---------------------------------- Code ---------------------------------->
@code 
{
    private List<Spot>? spots;

    private ApplicationUser CurrentUser { get; set; } = null!;

    private Spot? SelectedSpot { get; set; }

    private bool ShowUpcoming { get; set; } = true;

    private Spot? SelectedDescriptionSpot { get; set; }

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = await UserService.GetCurrentUser();

        await LoadSpotsAsync();
    }

    private async Task ShowUpcomingSpots()
    {
        ShowUpcoming = true;
        await LoadSpotsAsync();
    }

    private async Task ShowPastSpots()
    {
        ShowUpcoming = false;
        await LoadSpotsAsync();
    }

    private async Task LoadSpotsAsync()
    {
        spots = ShowUpcoming
            ? await SpotService.GetIncommingSpotsAsync()
            : await SpotService.GetPastSpotsAsync();
    }

    private void OpenAttendantsModal(Spot spot)
    {
        SelectedSpot = spot;
    }

    private async Task JoinOrLeaveSpotAsync(Spot spot)
    {
        if(spot.Attendants.Any(a => a.Id == CurrentUser.Id))
        {
            var result = await SpotService.RemoveSpotAttendantAsync(spot, CurrentUser);
            //TODO: handle result
            await LoadSpotsAsync();
        }
        else
        {
            var result = await SpotService.AddSpotAttendantAsync(spot, CurrentUser);
            //TODO: handle result
        }
    }

    private void CloseAttendantsModal()
    {
        SelectedSpot = null;
    }

    private void OpenDescriptionModal(Spot spot)
    {
        SelectedDescriptionSpot = spot;
    }

    private void CloseDescriptionModal()
    {
        SelectedDescriptionSpot = null;
    }

    private static string GetGoogleMapsUrl(Spot spot)
    {
        var address = $"{spot.City}, {spot.StreetAndNumber}";
        var encodedAddress = Uri.EscapeDataString(address);

        return $"https://www.google.com/maps/search/?api=1&query={encodedAddress}";
    }
}
