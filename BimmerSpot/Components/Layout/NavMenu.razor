@using BimmerSpot.Models.Eums
@using BimmerSpot.Services
@implements IDisposable

@inject NavigationManager NavigationManager
@inject IFeatureFlagService FeatureFlagService

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">BimmerSpot</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column h-100">
        <AuthorizeView>
            <!---- For all logged users ----> 
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Wstęp
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="CreateSpot">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Stwórz spot
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Spots">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Lista
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> @context.User.Identity?.Name
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Wyloguj
                        </button>
                    </form>
                </div>
            </Authorized>
            <!---- Only for NOT logged users ---->
            <NotAuthorized>
                @if (FeatureFlagService.AllowLocalAccountCreation())
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="Account/Register">
                            <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Zarejestruj
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Logowanie
                    </NavLink>
                </div>
                }

                <div class="nav-item px-3">
                    <form action="/Account/PerformExternalLogin" method="post">
                        <AntiforgeryToken />

                        <input type="hidden" name="provider" value="Facebook" />
                        <input type="hidden" name="returnUrl" value="/" />

                        <button type="submit" class="nav-link">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span>
                            Logowanie z Facebook
                        </button>
                    </form>
                </div>
            </NotAuthorized>
        </AuthorizeView>
        
        <div class="mt-auto">

            <AuthorizeView Roles="@UserRole.Admin.ToString()">
                <!---- Only for admin ---->
                <Authorized>
                    <details class="admin-menu">
                        <summary class="nav-link">
                            <span class="bi bi-shield-fill bootstrap-icon" aria-hidden="true"></span>
                            Admin
                            <span class="bi bi-chevron-down bootstrap-icon admin-chevron"
                                  aria-hidden="true"></span>
                        </summary>

                        <div class="admin-submenu">
                            <NavLink class="nav-link" href="Admin/Messages">
                                <span class="bi bi-envelope-fill bootstrap-icon" aria-hidden="true"></span>
                                Wiadomości
                            </NavLink>
                        </div>
                    </details>
                </Authorized>
                <!---- Visible for everyone but admin ---->
                <NotAuthorized>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="Contact">
                            <span class="bi bi-telephone-fill bootstrap-icon" aria-hidden="true"></span>
                            Kontakt
                        </NavLink>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </nav>
</div>

@code {
    private string? currentUrl;

    private bool AdminMenuOpen = false;

    private void ToggleAdminMenu()
    {
        AdminMenuOpen = !AdminMenuOpen;
    }

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

